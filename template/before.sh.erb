# 1. Export host, port, and security details
export host=$(hostname)
export port=$(find_port 8080)
export password=$(create_passwd 16)

# 2. Explicitly define the proxy sub-URI for Open OnDemand
export NODE_URI="/node/${host}/${port}"

# 3. Generate connection.yml for Open OnDemand's dashboard
cat <<EOF > connection.yml
host: "${host}"
port: "${port}"
password: "${password}"
type: jupyter
EOF

# 4. Generate Jupyter config file using token authentication
export CONFIG_FILE="${PWD}/config.py"

cat <<EOF > "${CONFIG_FILE}"
c.ServerApp.ip = '0.0.0.0'
c.ServerApp.port = ${port}
c.ServerApp.port_retries = 0
c.ServerApp.token = u'${password}'
c.ServerApp.password = u''
c.ServerApp.open_browser = False
c.ServerApp.allow_origin = '*'
c.ServerApp.base_url = '${NODE_URI}'
c.ServerApp.disable_check_xsrf = True

c.NotebookApp.ip = '0.0.0.0'
c.NotebookApp.port = ${port}
c.NotebookApp.port_retries = 0
c.NotebookApp.token = u'${password}'
c.NotebookApp.password = u''
c.NotebookApp.open_browser = False
c.NotebookApp.allow_origin = '*'
c.NotebookApp.base_url = '${NODE_URI}'
c.NotebookApp.disable_check_xsrf = True
EOF
