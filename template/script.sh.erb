#!/usr/bin/env bash

echo "Script starting..."

# 1. Environment cleanup
module purge 2>/dev/null
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

# 2. Load miniforge
module load <%= context.modules %> 2>/dev/null

# 3. Activate Conda environment
source /mnt/apps/manual/miniforge3/25.3.1-0_gcc-11.4.1/etc/profile.d/conda.sh
conda activate "${HOME}/.conda/envs/jupyter_env"

export PATH="${HOME}/.conda/envs/jupyter_env/bin:${PATH}"

# 4. Set working directory
export JUPYTER_DIR="<%= context.working_dir.blank? ? $HOME : context.working_dir %>"
cd "${JUPYTER_DIR}"

# 5. Determine launch command
if [ "<%= context.mode %>" == "1" ]; then
  export JUPYTER_ENABLE_LAB=1
  JUPYTER_CMD="jupyter lab"
else
  export JUPYTER_ENABLE_LAB=0
  JUPYTER_CMD="jupyter notebook"
fi

# 6. Launch Jupyter Server
set -x
${JUPYTER_CMD} --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %>
